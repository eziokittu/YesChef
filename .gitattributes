* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Keep Unity's text-serialized assets consistent across platforms.
*.cs text eol=lf
*.anim text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.asset text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.controller text eol=lf
*.hlsl text eol=lf
*.inputactions text eol=lf
*.json text eol=lf
*.mat text eol=lf
*.md text eol=lf
*.meta text eol=lf
*.prefab text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.unity text eol=lf
*.uss text eol=lf
*.uxml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Common binary assets must never be line-ending normalized.
*.aif binary
*.aiff binary
*.blend binary
*.fbx binary
*.gif binary
*.jpeg binary
*.jpg binary
*.mp3 binary
*.mp4 binary
*.ogg binary
*.otf binary
*.png binary
*.psd binary
*.tga binary
*.tif binary
*.tiff binary
*.ttf binary
*.wav binary
